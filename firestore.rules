rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Access Mode: Allows any user to read/write to the global bucket.
    // This removes authentication but preserves history for everyone.
    
    match /conversations/{conversationId} {
      allow read, write: if true;
    }
    
    match /messages/{messageId} {
      allow read, write: if true;
    }

    match /orchestrationEvents/{eventId} {
      allow read: if true; 
      allow write: if true; 
    }

    match /systemConfig/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}