# DualMind AI OS — Backend Environment Configuration
# Copy this file to .env, then fill in your API keys

# ============================================================
# LLM Providers
# ============================================================

# OpenRouter API Key (https://openrouter.ai/)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=microsoft/wizardlm-2-8x22b

# NVIDIA Build API Key (https://build.nvidia.com/)
NVIDIA_API_KEY=your-nvidia-key
NVIDIA_MODEL=mistralai/mistral-nemotron
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ============================================================
# Specialized Model Routing
# ============================================================
PRIMARY_REASONING_MODEL=mistralai/mistral-nemotron
FAST_STREAM_MODEL=mistralai/mistral-nemotron
PLANNER_MODEL=mistralai/mistral-nemotron
RERANK_MODEL=mistralai/mistral-nemotron
EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
OCR_MODEL=mistralai/mistral-nemotron
DOCUMENT_PARSE_MODEL=mistralai/mistral-nemotron

# ============================================================
# External Data APIs
# ============================================================
THENEWSAPI_KEY=your-news-api-key

# ============================================================
# Server Settings
# ============================================================
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=False
LOG_LEVEL=INFO
